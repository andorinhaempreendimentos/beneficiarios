# ─────────────────────────────────────────────────────────────
# Andorinha API — variáveis de ambiente
#
# Local:      copiar para .env e preencher
# Hostinger:  cadastrar em Dashboard › Environment Variables
#             (NÃO commitar o .env — está no .gitignore)
# ─────────────────────────────────────────────────────────────

# Aplicação -----------------------------------------------------
NODE_ENV=development
# Local usa 3001. Em produção a Hostinger injeta PORT automaticamente:
# deixe a variável FORA do painel para não sobrescrever o valor dela.
PORT=3001
TZ=America/Sao_Paulo
API_PREFIX=api/v1

# CORS e cookies ------------------------------------------------
# Origem do frontend. Produção: https://dominio.com
FRONTEND_URL=http://localhost:3000
# Vazio em local (localhost ignora domínio e compartilha entre portas).
# Produção: .dominio.com — com o ponto, para valer no subdomínio da API.
COOKIE_DOMAIN=

# Banco de dados (MySQL da Hostinger) ---------------------------
# Mesmo host nos dois ambientes; muda só DB_NAME.
# Requer IP liberado em hPanel › Bancos de Dados › Remote MySQL.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Rodar migrations pendentes no boot. Obrigatório true: a Hostinger
# não permite executar o CLI do TypeORM por SSH no Web App gerenciado.
DB_MIGRATIONS_RUN=true
DB_POOL_LIMIT=10

# JWT ------------------------------------------------------------
# Gerar com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=7d

# Storage — Cloudflare R2 (S3-compatible) -----------------------
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=andorinha-dev
# Segundos de validade das URLs pré-assinadas
R2_SIGNED_URL_TTL=900

# Seed inicial (só no primeiro boot, quando não há usuários) -----
ADMIN_NOME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Regras de negócio ---------------------------------------------
RESERVA_VAGA_TTL_MINUTOS=15
